# Supabase (cliente)
NEXT_PUBLIC_SUPABASE_URL=https://ulayaivxakzaghxaxlae.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role (SOLO servidor) — necesaria para invitar usuarios.
# Obtenla en Supabase → Project Settings → API → service_role secret.
# NUNCA la expongas en el cliente ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email (opcional) — notificaciones de aprobación/rechazo
RESEND_API_KEY=re_xxxx

# Zoho OAuth refresh (opcional) — para renovar el token automáticamente
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# El refresh_token se guarda en integration_settings.extra_config.refresh_token
