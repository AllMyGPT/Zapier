# LinkedIn OAuth 2.0 access token.
# Create an app at https://www.linkedin.com/developers/apps and generate a
# token with the scopes you need:
#   openid profile email      -> sign in / read profile
#   w_member_social           -> post as the signed-in member
#   w_organization_social     -> post as a Company Page (Community Mgmt API)
#   r_organization_admin      -> list administered Company Pages
LINKEDIN_ACCESS_TOKEN=your_oauth2_access_token

# Optional default author URN so you don't pass it every call.
#   Person: urn:li:person:<sub from linkedin_get_profile>
#   Org:    urn:li:organization:<id from linkedin_list_organizations>
LINKEDIN_AUTHOR_URN=

# Optional overrides
# LINKEDIN_API_VERSION=202506
# LINKEDIN_BASE_URL=https://api.linkedin.com
# LINKEDIN_TIMEOUT=30
