# Meta Graph API access token.
# Create a Meta app at https://developers.facebook.com/ and generate a
# long-lived User or Page access token with the permissions you need
# (pages_show_list, pages_read_engagement, pages_manage_posts, instagram_basic,
# instagram_content_publish, read_insights, ...).
META_ACCESS_TOKEN=your_long_lived_access_token

# Optional defaults so you don't have to pass ids every call.
META_PAGE_ID=
META_IG_USER_ID=

# Optional overrides
# META_API_VERSION=v21.0
# META_TIMEOUT=30
