# Metricool credentials (Settings -> API tab in your Metricool account)
# Requires an Advanced or Custom plan.
METRICOOL_USER_TOKEN=your_metricool_user_token
METRICOOL_USER_ID=your_numeric_user_id

# Optional: default brand id so you don't have to pass blog_id every call.
METRICOOL_BLOG_ID=

# Optional overrides
# METRICOOL_BASE_URL=https://app.metricool.com/api
# METRICOOL_TIMEOUT=30
