{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "780px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#1a6b3c",
          "name": "Primary"
        },
        {
          "slug": "primary-light",
          "color": "#2d9e5a",
          "name": "Primary Light"
        },
        {
          "slug": "primary-dark",
          "color": "#0f4526",
          "name": "Primary Dark"
        },
        {
          "slug": "secondary",
          "color": "#f59e0b",
          "name": "Secondary"
        },
        {
          "slug": "secondary-light",
          "color": "#fcd34d",
          "name": "Secondary Light"
        },
        {
          "slug": "accent",
          "color": "#3b82f6",
          "name": "Accent"
        },
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "Base"
        },
        {
          "slug": "base-2",
          "color": "#f8fafc",
          "name": "Base 2"
        },
        {
          "slug": "base-3",
          "color": "#f1f5f9",
          "name": "Base 3"
        },
        {
          "slug": "contrast",
          "color": "#0f172a",
          "name": "Contrast"
        },
        {
          "slug": "contrast-2",
          "color": "#334155",
          "name": "Contrast 2"
        },
        {
          "slug": "contrast-3",
          "color": "#64748b",
          "name": "Contrast 3"
        },
        {
          "slug": "border",
          "color": "#e2e8f0",
          "name": "Border"
        }
      ],
      "gradients": [
        {
          "slug": "primary-gradient",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-light) 100%)",
          "name": "Primary Gradient"
        },
        {
          "slug": "hero-gradient",
          "gradient": "linear-gradient(135deg, #0f172a 0%, #1a6b3c 60%, #2d9e5a 100%)",
          "name": "Hero Gradient"
        },
        {
          "slug": "subtle-gradient",
          "gradient": "linear-gradient(180deg, var(--wp--preset--color--base-2) 0%, var(--wp--preset--color--base) 100%)",
          "name": "Subtle Gradient"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Inter', 'Helvetica Neue', Arial, sans-serif",
          "slug": "inter",
          "name": "Inter"
        },
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "slug": "playfair",
          "name": "Playfair Display"
        },
        {
          "fontFamily": "'JetBrains Mono', 'Courier New', monospace",
          "slug": "mono",
          "name": "Monospace"
        }
      ],
      "fontSizes": [
        { "slug": "xs",    "size": "0.75rem",  "name": "XS" },
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium","size": "1rem",     "name": "Medium" },
        { "slug": "large", "size": "1.125rem", "name": "Large" },
        { "slug": "xl",    "size": "1.25rem",  "name": "XL" },
        { "slug": "2xl",   "size": "1.5rem",   "name": "2XL" },
        { "slug": "3xl",   "size": "1.875rem", "name": "3XL" },
        { "slug": "4xl",   "size": "2.25rem",  "name": "4XL" },
        { "slug": "5xl",   "size": "3rem",     "name": "5XL" },
        { "slug": "6xl",   "size": "3.75rem",  "name": "6XL" },
        { "slug": "7xl",   "size": "4.5rem",   "name": "7XL" }
      ],
      "fluid": true
    },
    "spacing": {
      "spacingScale": {
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem",
        "operator": "*",
        "increment": 1.5,
        "type": "fluid"
      },
      "spacingSizes": [
        { "slug": "10", "size": "0.25rem",  "name": "2XS" },
        { "slug": "20", "size": "0.5rem",   "name": "XS" },
        { "slug": "30", "size": "0.75rem",  "name": "S" },
        { "slug": "40", "size": "1rem",     "name": "M" },
        { "slug": "50", "size": "1.5rem",   "name": "L" },
        { "slug": "60", "size": "2rem",     "name": "XL" },
        { "slug": "70", "size": "3rem",     "name": "2XL" },
        { "slug": "80", "size": "4rem",     "name": "3XL" },
        { "slug": "90", "size": "6rem",     "name": "4XL" },
        { "slug": "100","size": "8rem",     "name": "5XL" }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "shadow": {
      "presets": [
        { "slug": "sm",  "shadow": "0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.06)", "name": "Small" },
        { "slug": "md",  "shadow": "0 4px 6px rgba(0,0,0,.07), 0 2px 4px rgba(0,0,0,.06)", "name": "Medium" },
        { "slug": "lg",  "shadow": "0 10px 15px rgba(0,0,0,.07), 0 4px 6px rgba(0,0,0,.05)", "name": "Large" },
        { "slug": "xl",  "shadow": "0 20px 25px rgba(0,0,0,.06), 0 8px 10px rgba(0,0,0,.04)", "name": "XL" },
        { "slug": "card","shadow": "0 2px 20px rgba(0,0,0,.08)", "name": "Card" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "blocks": {
      "core/button": {
        "color": {
          "palette": []
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--60)"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "clamp(2rem, 5vw, var(--wp--preset--font-size--5xl))",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "letterSpacing": "-0.025em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.5rem, 3.5vw, var(--wp--preset--font-size--4xl))",
          "fontWeight": "700",
          "lineHeight": "1.25",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 2.5vw, var(--wp--preset--font-size--3xl))",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "600"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600"
        },
        "border": {
          "radius": "6px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/group": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--80)",
            "bottom": "var(--wp--preset--spacing--80)"
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "clamp(1.75rem, 4vw, var(--wp--preset--font-size--5xl))",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "500"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header",          "title": "Cabecera",                "area": "header" },
    { "name": "header-minimal",  "title": "Cabecera Mínima",         "area": "header" },
    { "name": "footer",          "title": "Pie de Página",           "area": "footer" },
    { "name": "footer-minimal",  "title": "Pie de Página Mínimo",    "area": "footer" },
    { "name": "sidebar",         "title": "Barra Lateral",           "area": "uncategorized" },
    { "name": "post-meta",       "title": "Meta del Post",           "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "blank",           "title": "En Blanco (sin cabecera ni pie)" },
    { "name": "full-width",      "title": "Ancho Completo" },
    { "name": "landing-page",    "title": "Landing Page" },
    { "name": "portfolio",       "title": "Portafolio" },
    { "name": "pricing",         "title": "Precios" }
  ],
  "patterns": [
    "hero-default",
    "hero-centered",
    "features-grid",
    "features-list",
    "testimonials-slider",
    "cta-banner",
    "pricing-table",
    "team-grid",
    "contact-section",
    "faq-accordion",
    "stats-counter",
    "newsletter-signup",
    "blog-grid",
    "portfolio-grid",
    "services-cards"
  ]
}
