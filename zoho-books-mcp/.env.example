# Zoho Books OAuth2 Credentials
# Obtén estas credenciales en https://api-console.zoho.com/
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# ID de tu organización en Zoho Books
# Lo encuentras en Zoho Books > Settings > Organization Profile
ZOHO_ORGANIZATION_ID=your_organization_id_here

# Región de Zoho (com, eu, in, au, jp)
# España/Europa usa: eu
ZOHO_REGION=eu

# Moneda por defecto (código ISO 4217)
DEFAULT_CURRENCY=EUR
