{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "outDir": "build/scripts",
    "rootDir": "src",
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
