# Copia este archivo a .env y rellena tus valores

# API Key de OpenAI / Codex AI (obligatorio)
CODEX_API_KEY=sk-...

# URL base de la API (opcional, por defecto apunta a OpenAI)
CODEX_API_BASE=https://api.openai.com/v1

# Directorio donde se guardarán los proyectos importados (opcional)
OUTPUT_DIR=./imported_projects
