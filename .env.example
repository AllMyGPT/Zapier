# Credenciales del servidor MCP de Trello
# Copia este archivo como .env y completa los valores

# 1. Obtén tu API Key en: https://trello.com/power-ups/admin
TRELLO_API_KEY=tu_api_key_aqui

# 2. Genera un Token con este enlace (reemplaza YOUR_API_KEY):
#    https://trello.com/1/authorize?expiration=never&name=MCP+Trello+Agent&scope=read,write&response_type=token&key=YOUR_API_KEY
TRELLO_TOKEN=tu_token_aqui
